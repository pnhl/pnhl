rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Photos path: photos/{groupId}/{photoId}/{filename}
    match /photos/{groupId}/{photoId}/{filename} {
      // Allow read if user is member of the group
      allow read: if request.auth != null && 
        request.auth.uid in getGroupMemberIds(groupId);
      
      // Allow write if user is member of the group and file is an image
      allow write: if request.auth != null && 
        request.auth.uid in getGroupMemberIds(groupId) &&
        isValidImage();
      
      // Allow delete if user is the uploader or group admin
      allow delete: if request.auth != null && (
        isOwner() || isGroupAdmin(groupId, request.auth.uid)
      );
    }
    
    // User avatars path: avatars/{userId}/{filename}
    match /avatars/{userId}/{filename} {
      // Allow read for any authenticated user
      allow read: if request.auth != null;
      
      // Allow write only for the owner
      allow write: if request.auth != null && 
        request.auth.uid == userId &&
        isValidImage();
    }
    
    // Group avatars path: group_avatars/{groupId}/{filename}
    match /group_avatars/{groupId}/{filename} {
      // Allow read if user is member of the group
      allow read: if request.auth != null && 
        request.auth.uid in getGroupMemberIds(groupId);
      
      // Allow write if user is group admin
      allow write: if request.auth != null && 
        isGroupAdmin(groupId, request.auth.uid) &&
        isValidImage();
    }
    
    // Helper functions
    function getGroupMemberIds(groupId) {
      return firestore.get(/databases/(default)/documents/groups/$(groupId)).data.memberIds;
    }
    
    function isGroupAdmin(groupId, userId) {
      let groupData = firestore.get(/databases/(default)/documents/groups/$(groupId)).data;
      let members = groupData.members;
      return userId in groupData.memberIds && 
        getUserRole(members, userId) == 'admin';
    }
    
    function getUserRole(members, userId) {
      // This is simplified - in practice you'd need to iterate through members array
      // to find the user and get their role
      return 'member'; // Default role
    }
    
    function isOwner() {
      // Check if the current user is the owner of the file
      return resource.metadata.uploadedBy == request.auth.uid;
    }
    
    function isValidImage() {
      return request.resource.contentType.matches('image/.*') &&
        request.resource.size <= 10 * 1024 * 1024; // Max 10MB
    }
  }
}
