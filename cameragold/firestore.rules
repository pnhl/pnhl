rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Users collection
    match /users/{userId} {
      // Users can read and write their own data
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      // Users can read other users' public data (for group member info)
      allow read: if request.auth != null && 
        resource.data.keys().hasAny(['displayName', 'name', 'avatarUrl', 'lastSeenAt']);
    }
    
    // Groups collection
    match /groups/{groupId} {
      // Only group members can read group data
      allow read: if request.auth != null && 
        request.auth.uid in resource.data.memberIds;
      
      // Only group creator can create groups
      allow create: if request.auth != null && 
        request.auth.uid == request.resource.data.creatorId &&
        request.auth.uid in request.resource.data.memberIds;
      
      // Only group admins can update group data
      allow update: if request.auth != null &&
        request.auth.uid in resource.data.memberIds &&
        getUserRole(resource.data.members, request.auth.uid) == 'admin';
      
      // Only group admins can delete groups
      allow delete: if request.auth != null &&
        request.auth.uid in resource.data.memberIds &&
        getUserRole(resource.data.members, request.auth.uid) == 'admin';
    }
    
    // Photos collection
    match /photos/{photoId} {
      // Only group members can read photos
      allow read: if request.auth != null && 
        request.auth.uid in getGroupMemberIds(resource.data.groupId);
      
      // Only authenticated users can create photos in groups they belong to
      allow create: if request.auth != null && 
        request.auth.uid == request.resource.data.authorId &&
        request.auth.uid in getGroupMemberIds(request.resource.data.groupId);
      
      // Only photo author or group admin can update photos
      allow update: if request.auth != null && (
        request.auth.uid == resource.data.authorId ||
        isGroupAdmin(resource.data.groupId, request.auth.uid)
      );
      
      // Only photo author or group admin can delete photos
      allow delete: if request.auth != null && (
        request.auth.uid == resource.data.authorId ||
        isGroupAdmin(resource.data.groupId, request.auth.uid)
      );
      
      // Photo reactions subcollection
      match /reactions/{reactionId} {
        // Only group members can read reactions
        allow read: if request.auth != null && 
          request.auth.uid in getGroupMemberIds(getPhotoGroupId(photoId));
        
        // Only the reaction author can create their own reactions
        allow create: if request.auth != null && 
          request.auth.uid == request.resource.data.userId &&
          request.auth.uid in getGroupMemberIds(getPhotoGroupId(photoId));
        
        // Only the reaction author can update their own reactions
        allow update: if request.auth != null && 
          request.auth.uid == resource.data.userId;
        
        // Only the reaction author can delete their own reactions
        allow delete: if request.auth != null && 
          request.auth.uid == resource.data.userId;
      }
      
      // Photo comments subcollection
      match /comments/{commentId} {
        // Only group members can read comments
        allow read: if request.auth != null && 
          request.auth.uid in getGroupMemberIds(getPhotoGroupId(photoId));
        
        // Only group members can create comments
        allow create: if request.auth != null && 
          request.auth.uid == request.resource.data.authorId &&
          request.auth.uid in getGroupMemberIds(getPhotoGroupId(photoId));
        
        // Only comment author can update their own comments
        allow update: if request.auth != null && 
          request.auth.uid == resource.data.authorId;
        
        // Only comment author or group admin can delete comments
        allow delete: if request.auth != null && (
          request.auth.uid == resource.data.authorId ||
          isGroupAdmin(getPhotoGroupId(photoId), request.auth.uid)
        );
      }
    }
    
    // Group invites collection
    match /group_invites/{inviteId} {
      // Anyone can read active, non-expired invites
      allow read: if resource.data.isActive == true && 
        resource.data.expiresAt > request.time;
      
      // Only group admins can create invites
      allow create: if request.auth != null && 
        isGroupAdmin(request.resource.data.groupId, request.auth.uid);
      
      // Only invite creator or group admin can update invites
      allow update: if request.auth != null && (
        request.auth.uid == resource.data.createdBy ||
        isGroupAdmin(resource.data.groupId, request.auth.uid)
      );
      
      // Only invite creator or group admin can delete invites
      allow delete: if request.auth != null && (
        request.auth.uid == resource.data.createdBy ||
        isGroupAdmin(resource.data.groupId, request.auth.uid)
      );
    }
    
    // User widgets collection (for widget data)
    match /user_widgets/{userId} {
      // Only the user can read/write their widget data
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Blocked users collection
    match /blocked_users/{blockId} {
      // Only the blocking user can read/write their blocks
      allow read, write: if request.auth != null && 
        request.auth.uid == resource.data.blockerId;
    }
    
    // Reports collection
    match /reports/{reportId} {
      // Only the reporter can read their own reports
      allow read: if request.auth != null && 
        request.auth.uid == resource.data.reporterId;
      
      // Any authenticated user can create reports
      allow create: if request.auth != null && 
        request.auth.uid == request.resource.data.reporterId;
    }
    
    // Helper functions
    function getUserRole(members, userId) {
      return members[members.size() > 0 ? 
        members.findIndex(function(member) { return member.userId == userId }) : 0].role;
    }
    
    function getGroupMemberIds(groupId) {
      return get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds;
    }
    
    function isGroupAdmin(groupId, userId) {
      let groupData = get(/databases/$(database)/documents/groups/$(groupId)).data;
      let members = groupData.members;
      return members.hasAny([userId]) && 
        getUserRole(members, userId) == 'admin';
    }
    
    function getPhotoGroupId(photoId) {
      return get(/databases/$(database)/documents/photos/$(photoId)).data.groupId;
    }
    
    function isBlocked(userId, targetUserId) {
      return exists(/databases/$(database)/documents/blocked_users/$(userId + '_' + targetUserId)) ||
        exists(/databases/$(database)/documents/blocked_users/$(targetUserId + '_' + userId));
    }
  }
}
